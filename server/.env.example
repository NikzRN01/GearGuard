# Port the API listens on when run locally (ignored on serverless platforms).
PORT=5000

# Public URL of the FRONTEND. Used to build password reset links, and
# automatically added to the CORS allow-list.
APP_BASE_URL=http://localhost:5173

# Browser origins allowed to call this API, comma separated.
# REQUIRED in every deployed environment - the default only covers local dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Gmail credentials for the password reset email. Use an App Password, not the
# account password. If these are blank, reset mail is logged instead of sent,
# so the reset link never reaches the user.
SMTP_USER=
SMTP_PASS=

# Optional: force a mail transport. Set to "json" to build the reset email and
# log it instead of sending - useful for local work without SMTP credentials.
# The test suite sets this automatically.
# MAIL_TRANSPORT=json

# Optional: override the SQLite file location (defaults to server/portal.db).
# SQLITE_DB_PATH=./portal.db

# Set automatically by the platform / test runner; listed here for reference:
#   NODE_ENV  - "test" also exposes the reset token in the API response
#   VERCEL    - when set, the app does not bind a port and uses /tmp for SQLite
