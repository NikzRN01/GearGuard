# PostgreSQL connection string. REQUIRED - the server refuses to start without
# it. A Neon branch URL looks like:
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#
# TLS is applied to anything that is not loopback, with certificate verification
# on; Neon, Supabase and RDS all chain to public roots. Only sslmode=no-verify
# turns verification off, and sslmode=disable turns TLS off entirely.
#
# Neon publishes two endpoints per branch. Prefer the POOLED one (the host
# containing "-pooler") for serverless deployments: it fronts PgBouncer, so many
# short-lived instances do not exhaust the branch's connection ceiling.
DATABASE_URL=postgresql://gearguard:gearguard@127.0.0.1:55432/gearguard

# Optional: run every table inside a named schema instead of the default.
# Useful for putting staging beside production in one database. Must be a plain
# identifier. The test suite uses this to isolate each test process.
#
# REQUIRES A DIRECT (UNPOOLED) ENDPOINT. A transaction pooler multiplexes many
# clients onto few server connections and refuses startup parameters that would
# outlive one transaction, so Neon's "-pooler" host rejects search_path. Drop
# "-pooler" from the host when setting this. The server checks and says so
# rather than letting the driver fail with SQLSTATE 08P01 on the first query.
# DB_SCHEMA=

# Optional pool tuning. Keep `max` small on serverless, where many instances
# each hold their own pool against one database.
# PGPOOL_MAX=10
# PGPOOL_IDLE_MS=30000
# PGPOOL_CONNECT_MS=10000

# Port the API listens on when run locally (ignored on serverless platforms).
PORT=5000

# Populate comprehensive local showcase records on startup. Set to false when
# you want an empty development database. Always disabled in test/production.
SEED_SHOWCASE_DATA=true

# Create the demo accounts (manager@demo.com, admin@demo.com, ...) on startup.
# Their password is published in this repository, so they are REFUSED outright
# when NODE_ENV=production or when the platform sets VERCEL - no setting here
# can re-enable them. Set to false to keep them out of a local database too.
SEED_DEMO_DATA=true

# First-administrator bootstrap, for deployments where the demo seed is barred.
# Used only when the database contains no admin at all, so it cannot add a
# second one or reset an existing account. The password must satisfy the same
# policy as the signup form (8+ chars, upper, lower, special). Set these for
# the first boot, sign in, change the password, then remove them.
# BOOTSTRAP_ADMIN_EMAIL=ops@yourcompany.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=GearGuard Administrator

# Public URL of the FRONTEND. Used to build password reset links, and
# automatically added to the CORS allow-list.
CLIENT_URL=http://localhost:5173

# Browser origins allowed to call this API, comma separated.
# REQUIRED in every deployed environment - the default only covers local dev.
# Credentials are sent as cookies, so this must be an exact origin list.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# How long a login session stays valid, in milliseconds (default 8 hours).
SESSION_TTL_MS=28800000

# Number of proxy hops in front of this API. Behind Vercel, nginx or a load
# balancer this MUST be set, otherwise every request appears to come from the
# proxy and the auth rate limiter throttles all users as if they were one.
# Accepts anything Express understands: a hop count, "loopback", or a CIDR list.
# Leave blank when the API is exposed directly - trusting X-Forwarded-For with
# nothing in front to overwrite it lets a caller forge its own address.
# TRUST_PROXY=1

# Credential-endpoint ceilings, per address per 15 minutes.
# AUTH_LOGIN_RATE_MAX=10
# AUTH_SIGNUP_RATE_MAX=10
# AUTH_RECOVERY_RATE_MAX=5

# "production" also marks the session cookie Secure.
NODE_ENV=development

# Gmail credentials for the password reset email. Use an App Password, not the
# account password. If these are blank, reset mail is logged instead of sent,
# so the reset link never reaches the user.
SMTP_USER=
SMTP_PASS=

# Optional: force a mail transport. Set to "json" to build the reset email and
# log it instead of sending - useful for local work without SMTP credentials.
# The test suite sets this automatically.
# MAIL_TRANSPORT=json

# Optional: point the test suite at a different PostgreSQL instance. Falls back
# to DATABASE_URL, then to the local Docker container above.
# TEST_DATABASE_URL=postgresql://gearguard:gearguard@127.0.0.1:55432/gearguard

# Set automatically by the platform; listed here for reference:
#   VERCEL - when set, the app does not bind a port, and both demo seeds are
#            refused exactly as they are under NODE_ENV=production.
