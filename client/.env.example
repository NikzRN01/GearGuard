# Copy to .env and adjust for your environment.
#
# Vite only exposes variables prefixed with VITE_ to the browser, and it inlines
# them at BUILD time - so anything here ends up readable in the shipped bundle.
# Never put a secret in this file.

# Base URL of the GearGuard API, including the /api prefix.
# Defaults to http://localhost:5000/api when unset (see src/services/api.js).
# In a deployed environment set this to your API origin, e.g.
#   VITE_API_BASE_URL=https://gearguard-api.vercel.app/api
VITE_API_BASE_URL=http://localhost:5000/api
